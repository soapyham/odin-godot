{% if this.godot_name == "Input" %}
@(private = "file")
__Key_State :: struct {
    frame:     u64,
    down:      bool,
    prev_down: bool,
}

@(private = "file")
__key_states: map[Key]__Key_State

@(private = "file")
__logical_key_states: map[Key]__Key_State

@(private = "file")
__update_key_state :: proc "contextless" (self: Input, keycode_: Key) -> __Key_State {
    context = __bindgen_gde.godot_context()

    eng := singleton_engine()
    current_frame: u64
    if bool(engine_is_in_physics_frame(eng)) {
        current_frame = engine_get_physics_frames(eng)
    } else {
        current_frame = engine_get_process_frames(eng)
    }

    is_down := bool(input_is_physical_key_pressed(self, keycode_))

    state, exists := __key_states[keycode_]
    if !exists {
        new_state := __Key_State{
            frame     = current_frame,
            down      = is_down,
            prev_down = false,
        }
        __key_states[keycode_] = new_state
        return new_state
    }

    if state.frame != current_frame {
        if state.frame + 1 == current_frame {
            state.prev_down = state.down
        } else {
            state.prev_down = is_down
        }
        state.down = is_down
        state.frame = current_frame
        __key_states[keycode_] = state
    }

    return state
}

@(private = "file")
__update_logical_key_state :: proc "contextless" (self: Input, keycode_: Key) -> __Key_State {
    context = __bindgen_gde.godot_context()

    eng := singleton_engine()
    current_frame: u64
    if bool(engine_is_in_physics_frame(eng)) {
        current_frame = engine_get_physics_frames(eng)
    } else {
        current_frame = engine_get_process_frames(eng)
    }

    is_down := bool(input_is_key_pressed(self, keycode_))

    state, exists := __logical_key_states[keycode_]
    if !exists {
        new_state := __Key_State{
            frame     = current_frame,
            down      = is_down,
            prev_down = false,
        }
        __logical_key_states[keycode_] = new_state
        return new_state
    }

    if state.frame != current_frame {
        if state.frame + 1 == current_frame {
            state.prev_down = state.down
        } else {
            state.prev_down = is_down
        }
        state.down = is_down
        state.frame = current_frame
        __logical_key_states[keycode_] = state
    }

    return state
}

input_is_physical_key_pressed_down :: proc "contextless" (
    self: Input,
    keycode_: Key,
) -> (ret: Bool) {
    state := __update_key_state(self, keycode_)
    return Bool(state.down && !state.prev_down)
}

input_is_physical_key_released :: proc "contextless" (
    self: Input,
    keycode_: Key,
) -> (ret: Bool) {
    state := __update_key_state(self, keycode_)
    return Bool(!state.down && state.prev_down)
}

input_is_key_pressed_down :: proc "contextless" (
    self: Input,
    keycode_: Key,
) -> (ret: Bool) {
    state := __update_logical_key_state(self, keycode_)
    return Bool(state.down && !state.prev_down)
}

input_is_key_released :: proc "contextless" (
    self: Input,
    keycode_: Key,
) -> (ret: Bool) {
    state := __update_logical_key_state(self, keycode_)
    return Bool(!state.down && state.prev_down)
}
